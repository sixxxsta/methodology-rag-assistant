# =============================================================================
# Методолог — единый конфиг (cp .env.example .env)
# =============================================================================

# --- Web (Next.js) — http://localhost:3000 ---
WEB_PORT=3000
API_INTERNAL_URL=http://gateway:8090

# --- Gateway (API) — http://localhost:8090 ---
APP_HTTP_ADDR=:8090
RAG_SERVICE_URL=http://rag:8100
RAG_TIMEOUT_SECONDS=300
GATEWAY_PORT=8090

# Авторизация (обязательно смените в проде)
JWT_SECRET=change-me-to-random-string-at-least-32-chars
JWT_TTL_HOURS=72
AUTH_DB_PATH=/app/data/users.db
# Единственный администратор (остальные при регистрации — ученики)
ADMIN_EMAIL=admin@example.com
# Пароль модератора при первом запуске (если аккаунта ещё нет)
ADMIN_PASSWORD=change-me-admin-password
RAG_INTERNAL_SECRET=change-me-internal-rag-key

# --- EdAgent Core (workflow, фазы) — http://localhost:8200 ---
CORE_SERVICE_URL=http://core:8200
CORE_PORT=8200
CORE_INTERNAL_SECRET=change-me-core-internal-key
RATE_LIMIT_REGISTER_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30

# Скоринг компаний (сумма весов = 100)
SCORE_WEIGHT_COMPETENCY=40
SCORE_WEIGHT_SIZE=20
SCORE_WEIGHT_EDUCATION=20
SCORE_WEIGHT_WEBSITE=10
SCORE_WEIGHT_REGION=10

# Очередь исходящих писем (SMTP + worker)
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_OUTBOX_INTERVAL_SECONDS=60

# --- PostgreSQL ---
POSTGRES_USER=edagent
POSTGRES_PASSWORD=edagent
POSTGRES_DB=edagent
POSTGRES_PORT=5432
DATABASE_URL=postgresql://edagent:edagent@postgres:5432/edagent

# --- Redis (Celery) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_FOLLOWUP_INTERVAL_SECONDS=3600

# --- Уведомления куратору при эскалациях (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL=

# --- HeadHunter API (Фазы 1–2) ---
# Обязательно реальный email! example.com блокируется API hh.ru (bad_user_agent).
# Без токена при ошибке API подставляются демо-данные для теста.
HH_USER_AGENT=EdAgent/1.0 (your.name@urfu.ru)
HH_ACCESS_TOKEN=
HH_DEFAULT_AREA_ID=113
HH_CACHE_TTL_SECONDS=3600
HH_REQUEST_DELAY_MS=200

# --- Superjob API (второй источник вакансий, Sprint 4) ---
SUPERJOB_APP_ID=
SUPERJOB_SECRET_KEY=

# --- IMAP входящие (авто record_inbound, Sprint 4) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=300

# --- Outreach: tracking + классификация (Sprint 3) ---
# Публичный URL gateway для pixel tracking (открытие письма)
OUTREACH_TRACKING_BASE_URL=http://localhost:8080
# Секрет для POST /api/outreach/webhooks/email (SendGrid Event Webhook)
EMAIL_WEBHOOK_SECRET=
# LLM-классификация входящих ответов (false = только правила)
OUTREACH_USE_LLM=true

# --- Память агента (Sprint 5) ---
STRATEGY_MEMORY_ENABLED=true
QLORA_DATASET_DIR=data/qlora
QLORA_BASE_MODEL=IlyaGusev/saiga_llama3_8b

COMMS_USE_LLM=false
COMMS_LLM_TIMEOUT_SECONDS=20

# --- SMTP (опционально, FR-4.1) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- RAG Service ---
RAG_HTTP_PORT=8100
RAG_PORT=8100
CORS_ORIGINS=*

QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_COLLECTION=methodology_kb
QDRANT_API_KEY=

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
CHUNK_SIZE=800
CHUNK_OVERLAP=120
KNOWLEDGE_DIR=/knowledge
AUTO_INGEST_ON_STARTUP=true

# --- LLM: переключение модели ---
# inference  — локальная Qwen (нужен: docker compose --profile gpu up)
# gigachat   — API Сбера (нужен GIGACHAT_CREDENTIALS)
# auto       — GigaChat если есть credentials, иначе inference
LLM_PROVIDER=auto

INFERENCE_BASE_URL=http://inference:8000
INFERENCE_PORT=8000
INFERENCE_TIMEOUT_SECONDS=600

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=false

SYSTEM_PROMPT=Ты — методологический ментор для студенческих проектных команд. Отвечай строго на основе предоставленного контекста из базы знаний. Если в контексте нет ответа — честно скажи об этом.
RESPONSE_LANGUAGE=auto

# --- Inference (профиль gpu) ---
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
USE_4BIT=true
MIN_NEW_TOKENS=180
MAX_NEW_TOKENS=700
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.05
CONTEXT_MAX_CHARS=4000

HF_HOME=/models/hf-cache
TRANSFORMERS_CACHE=/models/hf-cache
HUGGINGFACE_HUB_CACHE=/models/hf-cache
SENTENCE_TRANSFORMERS_HOME=/models/hf-cache
