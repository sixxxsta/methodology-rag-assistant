# =============================================================================
# Методолог — единый конфиг (скопируйте: cp .env.example .env)
# =============================================================================

# --- Gateway (Go, :8090) ---
APP_HTTP_ADDR=:8090
STATIC_DIR=web
RAG_SERVICE_URL=http://rag:8100
RAG_TIMEOUT_SECONDS=120

# --- RAG Service (Python, :8100) ---
RAG_HTTP_PORT=8100
CORS_ORIGINS=*

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=methodology_kb
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32

# RAG retrieval
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
CHUNK_SIZE=800
CHUNK_OVERLAP=120
KNOWLEDGE_DIR=/knowledge
AUTO_INGEST_ON_STARTUP=true

# LLM: inference | gigachat
LLM_PROVIDER=inference
INFERENCE_BASE_URL=http://inference:8000
INFERENCE_TIMEOUT_SECONDS=600

# GigaChat — https://developers.sber.ru/docs/ru/gigachat/api/overview
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=false

SYSTEM_PROMPT=Ты — методологический ментор для студенческих проектных команд. Отвечай строго на основе предоставленного контекста из базы знаний. Если в контексте нет ответа — честно скажи об этом.
RESPONSE_LANGUAGE=auto

# --- Inference Service (Python, :8000, профиль gpu) ---
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
USE_4BIT=true
MIN_NEW_TOKENS=180
MAX_NEW_TOKENS=700
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.05
CONTEXT_MAX_CHARS=4000

# HuggingFace cache (Docker volumes)
HF_HOME=/models/hf-cache
TRANSFORMERS_CACHE=/models/hf-cache
HUGGINGFACE_HUB_CACHE=/models/hf-cache
SENTENCE_TRANSFORMERS_HOME=/models/hf-cache
